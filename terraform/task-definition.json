{
  "family": "atlas",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::090204645115:role/atlas-ecs-task-execution-role",
  "containerDefinitions": [
    {
      "name": "atlas",
      "image": "atlas-placeholder",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/atlas",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "atlas"
        }
      }
    }
  ]
}